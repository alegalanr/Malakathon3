# Copiar a .env y rellenar. .env no se sube al repo.

# Web a probar (por defecto, el casino simulado)
LOBBY_URL=http://localhost:8000/index.html

# IA con visión (plan B de la etapa 4)
VISION_PROVIDER=anthropic          # anthropic | openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Navegador (en Docker se fuerzan HEADLESS=true y BROWSER_CHANNEL vacío)
HEADLESS=true
BROWSER_CHANNEL=                   # vacío = Chromium de Playwright; chrome = Chrome instalado
RECORD_VIDEO=true

# Tiempos
GAME_LOAD_TIMEOUT_S=60
SPIN_WAIT_S=6
ROUND_WAIT_S=5

# Peticiones que cuentan como jugada (ajustar mirando DevTools > Network)
# SPIN_URL_REGEX=spin|/play|bet|round|wager|gameplay|doSpin
