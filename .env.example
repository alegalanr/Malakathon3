# Copiar a .env y rellenar. NUNCA subir .env al repositorio.
SITE=betsson_com
GAME_NAME=Starburst

VISION_PROVIDER=anthropic          # anthropic | openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

BETSSON_USERNAME=
BETSSON_PASSWORD=

HEADLESS=false
BROWSER_CHANNEL=chrome             # chrome | msedge | (vacío = chromium de Playwright)
VIEWPORT_W=1366
VIEWPORT_H=768
RECORD_VIDEO=true
RECORD_TRACE=true

NAV_TIMEOUT_MS=45000
GAME_LOAD_TIMEOUT_MS=60000
GAME_AGENT_MAX_STEPS=12
GLOBAL_RUN_TIMEOUT_S=300
