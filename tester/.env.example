# Cuentas de prueba de Betsson (las da Betsson). Copia este fichero a tester/.env y rellénalo.
# tester/.env NO se sube al repo. Solo hace falta para las ejecuciones reales:
# los tests unitarios y el modo simulado funcionan sin credenciales.

# Escenario 1: cuenta con saldo
BETSSON_ES_USER=
BETSSON_ES_PASS=

# Escenario 2: cuenta sin saldo suficiente (la preparan los mentores)
BETSSON_ES_EMPTY_USER=
BETSSON_ES_EMPTY_PASS=

# Opcionales
# MAX_BET=5            # apuesta máxima permitida en euros (por defecto 5)
# GAME_NAME=Bubble Up  # juego de Pragmatic Play a abrir
