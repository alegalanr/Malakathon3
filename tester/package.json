{
  "name": "betsson-game-tester",
  "private": true,
  "description": "Validador de juegos de Pragmatic Play en Betsson (SOLUCION.md + DISENO.md)",
  "scripts": {
    "test": "playwright test",
    "ui": "playwright test --ui-host=0.0.0.0 --ui-port=8080",
    "unit": "SKIP_LOGIN=1 playwright test --project=unit",
    "smoke": "SKIP_LOGIN=1 playwright test --project=lobby",
    "merge": "node scripts/merge-reports.mjs downloaded site",
    "scan": "node scripts/scan-secrets.mjs site",
    "report": "playwright show-report --host 0.0.0.0 --port 9323",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/prepare-tessdata.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/spa": "1.0.0",
    "@types/node": "^22.10.0",
    "@types/pngjs": "^6.0.5",
    "dotenv": "^16.4.5",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.5",
    "tesseract.js": "^5.1.1",
    "typescript": "^5.6.3",
    "zod": "^3.23.8"
  }
}
